---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Inicio | APECC - Asociación Peruana de Ciencias Jurídicas y Conciliación" description="Asociación Peruana de Ciencias Jurídicas y Conciliación" activePage="inicio">
<!-- Hero -->
        <div class="position-relative bg-dark overflow-hidden">
            <img class="w-100 h-auto d-block" src="/images/carrusel1.jpg" alt="APECC - Consorcio Jurídico & Asociados"
                fetchpriority="high">
        </div>
        <!-- End Hero -->

        <!-- Featured Diplomats -->
        <section class="overflow-hidden">
            <div class="container content-space-t-1">
                <!-- Title -->
                <div class="w-md-75 text-center mx-md-auto mb-5">
                    <h2>
                        <a href="/diplomados">Nuestras pasantias</a>
                    </h2>
                    <p>Extiende tu carrera y sigue aprendiendo.</p>
                </div>
                <!-- End Title -->

                <!-- Swiper Slider -->
                <div class="swiper-centered position-relative">
                    <div class="js-swiper-diplomat js-swiper-pagination swiper">
                        <div class="swiper-wrapper">

                            <!-- Slide 1: Pasantía Argentina -->
                            <div class="swiper-slide mb-5">
                                <div class="card card-bordered h-100">
                                    <a class="card-pinned"
                                        href="https://wa.me/51996894991?text=Hola%2C%20solicito%20informaci%C3%B3n%20sobre%20la%20Pasant%C3%ADa%20Internacional%20en%20Argentina."
                                        target="_blank">
                                        <img class="card-img-top" src="/Cursos/pasantia_argentina.jpg"
                                            alt="Pasantía Internacional en Litigación Oral - Argentina">
                                        <div class="card-pinned-top-start">
                                            <small class="badge bg-danger rounded-pill"><i class="bi-globe me-1"></i>
                                                Internacional</small>
                                        </div>
                                    </a>
                                    <div class="card-body p-3 p-sm-5">
                                        <small class="text-primary">Pasantía Internacional</small>
                                        <div class="mb-3">
                                            <h4 class="card-title">
                                                <a class="text-dark max-lines-2"
                                                    href="https://wa.me/51996894991?text=Hola%2C%20solicito%20informaci%C3%B3n%20sobre%20la%20Pasant%C3%ADa%20Internacional%20en%20Argentina."
                                                    target="_blank">
                                                    Pasantía Internacional en Litigación Oral - Argentina
                                                </a>
                                            </h4>
                                        </div>
                                        <div class="d-flex align-items-top justify-content-between small">
                                            <div class="text-muted"><i class="bi-geo-alt me-1"></i> Buenos Aires</div>
                                            <div class="text-muted"><i class="bi-building me-1"></i> Audiencias in situ
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-footer pt-0 p-3 px-sm-5 pb-sm-5">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="me-2">
                                                <h5 class="card-title text-success mb-0" style="font-size: 0.95rem;">
                                                    Cupos limitados</h5>
                                            </div>
                                            <a class="btn btn-success btn-sm btn-transition"
                                                href="https://wa.me/51996894991?text=Hola%2C%20solicito%20informaci%C3%B3n%20sobre%20la%20Pasant%C3%ADa%20Internacional%20en%20Argentina."
                                                target="_blank">
                                                <i class="bi-whatsapp me-1"></i> WhatsApp
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 2: Pasantía Brasil -->
                            <div class="swiper-slide mb-5">
                                <div class="card card-bordered h-100">
                                    <a class="card-pinned"
                                        href="https://wa.me/51996894991?text=Hola%2C%20solicito%20informaci%C3%B3n%20sobre%20la%20Pasant%C3%ADa%20Internacional%20en%20Brasil."
                                        target="_blank">
                                        <img class="card-img-top" src="/Cursos/pasantia_brasil.jpg"
                                            alt="Pasantía Internacional en Derecho y Litigación - Brasil">
                                        <div class="card-pinned-top-start">
                                            <small class="badge bg-danger rounded-pill"><i class="bi-globe me-1"></i>
                                                Internacional</small>
                                        </div>
                                    </a>
                                    <div class="card-body p-3 p-sm-5">
                                        <small class="text-primary">Pasantía Internacional</small>
                                        <div class="mb-3">
                                            <h4 class="card-title">
                                                <a class="text-dark max-lines-2"
                                                    href="https://wa.me/51996894991?text=Hola%2C%20solicito%20informaci%C3%B3n%20sobre%20la%20Pasant%C3%ADa%20Internacional%20en%20Brasil."
                                                    target="_blank">
                                                    Pasantía Internacional en Derecho y Litigación - Brasil
                                                </a>
                                            </h4>
                                        </div>
                                        <div class="d-flex align-items-top justify-content-between small">
                                            <div class="text-muted"><i class="bi-geo-alt me-1"></i> Brasil</div>
                                            <div class="text-muted"><i class="bi-building me-1"></i> Audiencias in situ
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-footer pt-0 p-3 px-sm-5 pb-sm-5">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="me-2">
                                                <h5 class="card-title text-success mb-0" style="font-size: 0.95rem;">
                                                    Cupos limitados</h5>
                                            </div>
                                            <a class="btn btn-success btn-sm btn-transition"
                                                href="https://wa.me/51996894991?text=Hola%2C%20solicito%20informaci%C3%B3n%20sobre%20la%20Pasant%C3%ADa%20Internacional%20en%20Brasil."
                                                target="_blank">
                                                <i class="bi-whatsapp me-1"></i> WhatsApp
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 3: Pasantía Miami -->
                            <div class="swiper-slide mb-5">
                                <div class="card card-bordered h-100">
                                    <a class="card-pinned"
                                        href="https://wa.me/51996894991?text=Hola%2C%20solicito%20informaci%C3%B3n%20sobre%20la%20Pasant%C3%ADa%20Internacional%20en%20Miami%20%28EE.UU.%29."
                                        target="_blank">
                                        <img class="card-img-top" src="/Cursos/pasantia_miami.jpg"
                                            alt="Pasantía Internacional en Litigación Oral y Sistema Acusatorio - Miami">
                                        <div class="card-pinned-top-start">
                                            <small class="badge bg-danger rounded-pill"><i class="bi-globe me-1"></i>
                                                Internacional</small>
                                        </div>
                                    </a>
                                    <div class="card-body p-3 p-sm-5">
                                        <small class="text-primary">Pasantía Internacional</small>
                                        <div class="mb-3">
                                            <h4 class="card-title">
                                                <a class="text-dark max-lines-2"
                                                    href="https://wa.me/51996894991?text=Hola%2C%20solicito%20informaci%C3%B3n%20sobre%20la%20Pasant%C3%ADa%20Internacional%20en%20Miami%20%28EE.UU.%29."
                                                    target="_blank">
                                                    Pasantía en Litigación Oral y Sistema Acusatorio - Miami (EE.UU.)
                                                </a>
                                            </h4>
                                        </div>
                                        <div class="d-flex align-items-top justify-content-between small">
                                            <div class="text-muted"><i class="bi-geo-alt me-1"></i> Miami, Florida</div>
                                            <div class="text-muted"><i class="bi-building me-1"></i> Cortes Federales
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-footer pt-0 p-3 px-sm-5 pb-sm-5">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="me-2">
                                                <h5 class="card-title text-success mb-0" style="font-size: 0.95rem;">
                                                    Cupos limitados</h5>
                                            </div>
                                            <a class="btn btn-success btn-sm btn-transition"
                                                href="https://wa.me/51996894991?text=Hola%2C%20solicito%20informaci%C3%B3n%20sobre%20la%20Pasant%C3%ADa%20Internacional%20en%20Miami%20%28EE.UU.%29."
                                                target="_blank">
                                                <i class="bi-whatsapp me-1"></i> WhatsApp
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 4: Formación de Conciliadores -->
                            <div class="swiper-slide mb-5">
                                <div class="card card-bordered h-100">
                                    <a class="card-pinned"
                                        href="https://apecc.com.pe/noticias/producto/curso-de-formacion-y-capacitacion-de-conciliadores-extrajudiciales/">
                                        <img class="card-img-top" src="/Cursos/conciliacion_2.jpg"
                                            alt="Curso de Formación y Capacitación de Conciliadores Extrajudiciales">
                                        <div class="card-pinned-top-start">
                                            <small class="badge bg-success rounded-pill">Oficial MINJUS</small>
                                        </div>
                                    </a>
                                    <div class="card-body p-3 p-sm-5">
                                        <small class="text-primary">Conciliación Extrajudicial</small>
                                        <div class="mb-3">
                                            <h4 class="card-title">
                                                <a class="text-dark max-lines-2"
                                                    href="https://apecc.com.pe/noticias/producto/curso-de-formacion-y-capacitacion-de-conciliadores-extrajudiciales/">
                                                    Curso de Formación y Capacitación de Conciliadores Extrajudiciales
                                                </a>
                                            </h4>
                                        </div>
                                        <div class="d-flex align-items-top justify-content-between small">
                                            <div class="text-muted"><i class="bi-award me-1"></i> R.M. 122-2000-JUS
                                            </div>
                                            <div class="text-muted"><i class="bi-shield-check me-1"></i> MINJUS</div>
                                        </div>
                                    </div>
                                    <div class="card-footer pt-0 p-3 px-sm-5 pb-sm-5">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="me-2">
                                                <h5 class="card-title text-primary mb-0">S/ 380.00</h5>
                                            </div>
                                            <a class="btn btn-primary btn-sm btn-transition"
                                                href="https://apecc.com.pe/noticias/producto/curso-de-formacion-y-capacitacion-de-conciliadores-extrajudiciales/">
                                                <i class="bi-cart-plus me-1"></i> Comprar
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- Swiper Pagination -->
                        <div class="js-swiper-diplomat-pagination-element swiper-pagination mt-0"></div>

                        <!-- Arrows -->
                        <div class="d-none d-sm-block">
                            <div class="js-swiper-diplomat-slides-per-view-button-next"
                                style="position: absolute; top: 50%; right: -7%;">
                                <i class="bi bi-chevron-right display-5 text-dark-25"></i>
                            </div>
                            <div class="js-swiper-diplomat-slides-per-view-button-prev"
                                style="position: absolute; top: 50%; left: -7%;">
                                <i class="bi bi-chevron-left display-5 text-dark-25"></i>
                            </div>
                        </div>

                        <div class="mt-5 d-none">
                            <div class="js-swiper-diplomat-slides-per-view-button-next swiper-button-next"></div>
                            <div class="js-swiper-diplomat-slides-per-view-button-prev swiper-button-prev"></div>
                        </div>
                    </div>
                    <!-- End Row -->
                </div>
            </div>
        </section>
        <!-- End Featured Diplomats -->

        <!-- Featured RE Courses -->
        <section class="overflow-hidden">
            <style>
                .js-swiper-re-course .swiper-slide {
                    height: auto !important;
                    display: flex !important;
                }
                .js-swiper-re-course .card {
                    height: 100% !important;
                    display: flex !important;
                    flex-direction: column !important;
                    width: 100% !important;
                }
                .js-swiper-re-course .card-img-top {
                    height: 220px !important;
                    object-fit: cover !important;
                    object-position: center !important;
                    width: 100% !important;
                }
                .js-swiper-re-course .card-body {
                    display: flex !important;
                    flex-direction: column !important;
                    flex-grow: 1 !important;
                }
            </style>
            <div class="container content-space-t-1">
                <!-- Title -->
                <div class="w-md-75 text-center mx-md-auto mb-5">
                    <h2>
                        <a href="/cursos-especializados">Cursos de actualización</a>
                    </h2>
                    <p>Desarrolla nuevas habilidades.</p>
                </div>
                <!-- End Title -->

                <!-- Swiper Slider -->
                <div class="swiper-centered position-relative">
                    <div class="js-swiper-re-course js-swiper-pagination swiper">
                        <div class="swiper-wrapper">

                            <!-- Slide 1: Corrupción de Funcionarios -->
                            <div class="swiper-slide mb-5 h-auto d-flex">
                                <div class="card card-bordered h-100 w-100 d-flex flex-column shadow-sm overflow-hidden">
                                    <a class="card-pinned d-block"
                                        href="https://apecc.com.pe/noticias/producto/corrupcion-de-funcionarios-crimen-organizado-y-analisis-del-caso/">
                                        <img class="card-img-top" src="/Cursos/CFCAL.jpg"
                                            alt="Corrupción de Funcionarios, Crimen Organizado y Análisis del Caso"
                                            style="height: 220px; width: 100%; object-fit: cover; object-position: center;">
                                        <div class="card-pinned-top-start">
                                            <small class="badge bg-primary rounded-pill">En vivo</small>
                                        </div>
                                    </a>
                                    <div class="card-body p-3 p-sm-5 d-flex flex-column flex-grow-1">
                                        <small class="text-primary fw-semibold mb-1">Derecho Penal</small>
                                        <div class="mb-3" style="min-height: 3.5rem;">
                                            <h4 class="card-title">
                                                <a class="text-dark max-lines-2"
                                                    href="https://apecc.com.pe/noticias/producto/corrupcion-de-funcionarios-crimen-organizado-y-analisis-del-caso/">
                                                    Corrupción de Funcionarios, Crimen Organizado y Análisis del Caso
                                                </a>
                                            </h4>
                                        </div>
                                        <div class="d-flex align-items-top justify-content-between small mt-auto pt-2">
                                            <div class="text-muted"><i class="bi-mortarboard me-1"></i> Alta
                                                Especialización</div>
                                            <div class="text-muted"><i class="bi-laptop me-1"></i> Virtual</div>
                                        </div>
                                    </div>
                                    <div class="card-footer pt-0 p-3 px-sm-5 pb-sm-5 mt-auto">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="me-2">
                                                <h5 class="card-title text-primary mb-0">S/ 200.00</h5>
                                            </div>
                                            <a class="btn btn-primary btn-sm btn-transition"
                                                href="https://apecc.com.pe/noticias/producto/corrupcion-de-funcionarios-crimen-organizado-y-analisis-del-caso/">
                                                <i class="bi-cart-plus me-1"></i> Comprar
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 2: Conciliación Extrajudicial Familiar -->
                            <div class="swiper-slide mb-5 h-auto d-flex">
                                <div class="card card-bordered h-100 w-100 d-flex flex-column shadow-sm overflow-hidden">
                                    <a class="card-pinned d-block"
                                        href="https://apecc.com.pe/noticias/producto/conciliacion-extrajudicial-familiar/">
                                        <img class="card-img-top" src="/Cursos/conciliacion.jpg"
                                            alt="Conciliación Extrajudicial Familiar"
                                            style="height: 220px; width: 100%; object-fit: cover; object-position: center;">
                                        <div class="card-pinned-top-start">
                                            <small class="badge bg-primary rounded-pill">Especialización</small>
                                        </div>
                                    </a>
                                    <div class="card-body p-3 p-sm-5 d-flex flex-column flex-grow-1">
                                        <small class="text-primary fw-semibold mb-1">Conciliación Extrajudicial</small>
                                        <div class="mb-3" style="min-height: 3.5rem;">
                                            <h4 class="card-title">
                                                <a class="text-dark max-lines-2"
                                                    href="https://apecc.com.pe/noticias/producto/conciliacion-extrajudicial-familiar/">
                                                    Conciliación Extrajudicial Familiar
                                                </a>
                                            </h4>
                                        </div>
                                        <div class="d-flex align-items-top justify-content-between small mt-auto pt-2">
                                            <div class="text-muted"><i class="bi-people me-1"></i> Derecho de Familia
                                            </div>
                                            <div class="text-muted"><i class="bi-laptop me-1"></i> En vivo</div>
                                        </div>
                                    </div>
                                    <div class="card-footer pt-0 p-3 px-sm-5 pb-sm-5 mt-auto">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="me-2">
                                                <h5 class="card-title text-primary mb-0">S/ 300.00</h5>
                                            </div>
                                            <a class="btn btn-primary btn-sm btn-transition"
                                                href="https://apecc.com.pe/noticias/producto/conciliacion-extrajudicial-familiar/">
                                                <i class="bi-cart-plus me-1"></i> Comprar
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 3: Arbitraje -->
                            <div class="swiper-slide mb-5 h-auto d-flex">
                                <div class="card card-bordered h-100 w-100 d-flex flex-column shadow-sm overflow-hidden">
                                    <a class="card-pinned d-block"
                                        href="https://apecc.com.pe/noticias/producto/curso-de-especializacion-en-arbitraje/">
                                        <img class="card-img-top" src="/Cursos/Curso_especializacion.jpg"
                                            alt="Curso de Especialización en Arbitraje"
                                            style="height: 220px; width: 100%; object-fit: cover; object-position: center;">
                                        <div class="card-pinned-top-start">
                                            <small class="badge bg-primary rounded-pill">Especialización</small>
                                        </div>
                                    </a>
                                    <div class="card-body p-3 p-sm-5 d-flex flex-column flex-grow-1">
                                        <small class="text-primary fw-semibold mb-1">Arbitraje y Conflictos</small>
                                        <div class="mb-3" style="min-height: 3.5rem;">
                                            <h4 class="card-title">
                                                <a class="text-dark max-lines-2"
                                                    href="https://apecc.com.pe/noticias/producto/curso-de-especializacion-en-arbitraje/">
                                                    Curso de Especialización en Arbitraje
                                                </a>
                                            </h4>
                                        </div>
                                        <div class="d-flex align-items-top justify-content-between small mt-auto pt-2">
                                            <div class="text-muted"><i class="bi-briefcase me-1"></i> Centro APECC</div>
                                            <div class="text-muted"><i class="bi-laptop me-1"></i> Virtual</div>
                                        </div>
                                    </div>
                                    <div class="card-footer pt-0 p-3 px-sm-5 pb-sm-5 mt-auto">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="me-2">
                                                <h5 class="card-title text-primary mb-0">S/ 150.00</h5>
                                            </div>
                                            <a class="btn btn-primary btn-sm btn-transition"
                                                href="https://apecc.com.pe/noticias/producto/curso-de-especializacion-en-arbitraje/">
                                                <i class="bi-cart-plus me-1"></i> Comprar
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Slide 4: Delitos Contra la Libertad Sexual -->
                            <div class="swiper-slide mb-5 h-auto d-flex">
                                <div class="card card-bordered h-100 w-100 d-flex flex-column shadow-sm overflow-hidden">
                                    <a class="card-pinned d-block"
                                        href="https://apecc.com.pe/noticias/producto/seminario-sobre-delitos-contra-la-libertad-sexual-mineria-ilegal-y-corrupcion/">
                                        <img class="card-img-top" src="/Cursos/Delitos_Contra_Libertad_smic.jpg"
                                            alt="Seminario sobre Delitos Contra la Libertad Sexual, Minería Ilegal y Corrupción"
                                            style="height: 220px; width: 100%; object-fit: cover; object-position: center;">
                                        <div class="card-pinned-top-start">
                                            <small class="badge bg-primary rounded-pill">Seminario</small>
                                        </div>
                                    </a>
                                    <div class="card-body p-3 p-sm-5 d-flex flex-column flex-grow-1">
                                        <small class="text-primary fw-semibold mb-1">Derecho Penal</small>
                                        <div class="mb-3" style="min-height: 3.5rem;">
                                            <h4 class="card-title">
                                                <a class="text-dark max-lines-2"
                                                    href="https://apecc.com.pe/noticias/producto/seminario-sobre-delitos-contra-la-libertad-sexual-mineria-ilegal-y-corrupcion/">
                                                    Delitos Contra la Libertad Sexual, Minería Ilegal y Corrupción
                                                </a>
                                            </h4>
                                        </div>
                                        <div class="d-flex align-items-top justify-content-between small mt-auto pt-2">
                                            <div class="text-muted"><i class="bi-mortarboard me-1"></i> Litigación Penal
                                            </div>
                                            <div class="text-muted"><i class="bi-laptop me-1"></i> En vivo</div>
                                        </div>
                                    </div>
                                    <div class="card-footer pt-0 p-3 px-sm-5 pb-sm-5 mt-auto">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="me-2">
                                                <h5 class="card-title text-primary mb-0">S/ 200.00</h5>
                                            </div>
                                            <a class="btn btn-primary btn-sm btn-transition"
                                                href="https://apecc.com.pe/noticias/producto/seminario-sobre-delitos-contra-la-libertad-sexual-mineria-ilegal-y-corrupcion/">
                                                <i class="bi-cart-plus me-1"></i> Comprar
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- Swiper Pagination -->
                        <div class="js-swiper-re-course-pagination-element swiper-pagination mt-0"></div>

                        <!-- Arrows -->
                        <div class="d-none d-sm-block">
                            <div class="js-swiper-re-course-slides-per-view-button-next"
                                style="position: absolute; top: 50%; right: -7%;">
                                <i class="bi bi-chevron-right display-5 text-dark-25"></i>
                            </div>
                            <div class="js-swiper-re-course-slides-per-view-button-prev"
                                style="position: absolute; top: 50%; left: -7%;">
                                <i class="bi bi-chevron-left display-5 text-dark-25"></i>
                            </div>
                        </div>

                        <div class="mt-5 d-none">
                            <div class="js-swiper-re-course-slides-per-view-button-next swiper-button-next"></div>
                            <div class="js-swiper-re-course-slides-per-view-button-prev swiper-button-prev"></div>
                        </div>
                    </div>
                    <!-- End Row -->
                </div>
            </div>
        </section>
        <!-- End Featured RE Courses -->



        <!-- Libreria Juridica APECC -->
        <section id="libreria" class="overflow-hidden py-5 bg-white border-top border-bottom">
            <div class="container content-space-1">
                <div class="w-md-75 text-center mx-md-auto mb-5">
                    <span
                        class="badge bg-soft-primary text-primary rounded-pill mb-2 px-3 py-2 fw-bold text-uppercase">Editorial
