<script is:inline>
document.addEventListener('DOMContentLoaded', function () {
    if (typeof Swiper === 'undefined') return;

    if (document.querySelector('.js-swiper-diplomat')) {
        new Swiper('.js-swiper-diplomat', {
            slidesPerView: 3,
            slidesPerGroup: 3,
            spaceBetween: 20,
            navigation: {
                nextEl: '.js-swiper-diplomat-slides-per-view-button-next',
                prevEl: '.js-swiper-diplomat-slides-per-view-button-prev',
                disabledClass: 'text-light swiper-button-disabled cursor-auto',
                hiddenClass: 'd-none'
            },
            pagination: {
                el: '.js-swiper-diplomat-pagination-element',
                clickable: true
            },
            breakpoints: {
                0: { slidesPerView: 1.3, slidesPerGroup: 1, spaceBetween: 10 },
                576: { slidesPerView: 1, slidesPerGroup: 1, spaceBetween: 10 },
                768: { slidesPerView: 2, slidesPerGroup: 2, spaceBetween: 15 },
