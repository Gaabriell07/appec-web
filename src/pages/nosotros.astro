---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Acerca de nosotros | APECC - Asociación Peruana de Ciencias Jurídicas y Conciliación" description="Asociación Peruana de Ciencias Jurídicas y Conciliación" activePage="nosotros">
<!-- Gallery -->
        <div class="container content-space-t-1 content-space-t-md-3 content-space-t-lg-5">
            <div class="w-lg-75 text-center mx-lg-auto">
                <!-- Heading -->
                <div class="mb-5 mb-md-10">
                    <h1 class="display-4">¡Bienvenidos a APECC!</h1>
                    <p class="fs-5">
                        En la <strong>Asociación Peruana de Ciencias Jurídicas y Conciliación (APECC)</strong>,
                        impulsamos el desarrollo académico y profesional mediante una formación jurídica especializada,
                        innovadora y de calidad. Ofrecemos cursos, diplomados y programas presenciales y virtuales,
                        integrando nuevas tecnologías y promoviendo pasantías internacionales que amplían conocimientos
                        y fortalecen competencias profesionales.
                    </p>
                    <p>
                        Nuestro compromiso es fomentar la excelencia académica, el pensamiento crítico y la
                        actualización continua de estudiantes, egresados y profesionales del Derecho, brindándoles
                        herramientas para afrontar los desafíos del entorno jurídico actual.
                    </p>
                    <p class="fst-italic text-secondary">
                        Te invitamos a ser parte de nuestra comunidad académica, donde la innovación, el conocimiento y
                        la proyección internacional impulsan tu futuro profesional.
                    </p>
                    <div class="pt-2">
                        <h5 class="text-primary mb-0">Dr. Oscar Peña Gonzáles</h5>
                        <span class="text-muted small">Presidente</span>
                    </div>
                </div>
                <!-- End Heading -->
            </div>

            <div class="row gx-3">
                <div class="col mb-3">
                    <div class="bg-img-start"
                        style="background-image: url(images/nosotros1.webp); height: 15rem; background-size: cover; background-position: center;">
                    </div>
                </div>
                <!-- End Col -->

                <div class="col-3 d-none d-md-block mb-3">
                    <div class="bg-img-start"
                        style="background-image: url(images/nosotros2.webp); height: 15rem; background-size: cover; background-position: center;">
                    </div>
                </div>
                <!-- End Col -->

                <div class="col mb-3">
                    <div class="bg-img-start"
                        style="background-image: url(images/nosotros3.webp); height: 15rem; background-size: cover; background-position: center;">
                    </div>
                </div>
                <!-- End Col -->

                <div class="w-100"></div>

                <div class="col mb-3 mb-md-0">
                    <div class="bg-img-start"
                        style="background-image: url(images/nosotros4.webp); height: 15rem; background-size: cover; background-position: center;">
                    </div>
                </div>
                <!-- End Col -->

                <div class="col-4 d-none d-md-block mb-3 mb-md-0">
                    <div class="bg-img-start"
                        style="background-image: url(images/nosotros5.webp); height: 15rem; background-size: cover; background-position: center;">
                    </div>
                </div>
                <!-- End Col -->

                <div class="col">
                    <div class="bg-img-start"
                        style="background-image: url(images/nosotros6.webp); height: 15rem; background-size: cover; background-position: center;">
                    </div>
                </div>
                <!-- End Col -->
            </div>
            <!-- End Row -->
        </div>
        <!-- End Gallery -->

        <!-- Feature Stats -->
        <div class="container content-space-2 content-space-lg-3">
            <div class="row justify-content-lg-center">
                <div class="col-sm-4 col-lg-3 mb-7 mb-sm-0">
                    <div class="text-center">
                        <h2 class="display-4">+25 años</h2>
                        <p class="small">de trayectoria jurídica</p>
                    </div>
                </div>
                <!-- End Col -->

                <div class="col-sm-4 col-lg-3 mb-7 mb-sm-0">
                    <div class="text-center">
                        <h2 class="display-4">+150</h2>
                        <p class="small">docentes de primer nivel</p>
                    </div>
                </div>
                <!-- End Col -->

                <div class="col-sm-4 col-lg-3">
                    <div class="text-center">
                        <h2 class="display-4">6 países</h2>
                        <p class="small">pasantías internacionales</p>
                    </div>
                </div>
                <!-- End Col -->
            </div>
            <!-- End Row -->
        </div>
        <!-- End Feature Stats -->

        <div class="border-top mx-auto" style="max-width: 25rem;"></div>

        <!-- ================= SOBRE APECC / ¿QUIÉNES SOMOS? ================= -->
        <div id="quienes-somos" class="py-7 py-lg-10" style="background-color: #F0EADC;">
            <div class="container">
                <div class="row justify-content-lg-between align-items-center">
                    <div class="col-lg-5 mb-5 mb-lg-0">
                        <span class="badge px-3 py-2 rounded-pill mb-3"
                            style="background-color: #F49685; color: #FFFFFF; font-weight: 600; letter-spacing: 0.5px;">
                            Sobre APECC
                        </span>
                        <h2 class="display-5 mb-4" style="color: #01254D; font-weight: 700;">¿Quiénes somos?</h2>
                        <p class="lead fs-5 mb-3" style="color: #01254D; line-height: 1.6;">
                            <strong>APECC</strong>, Centro de capacitación y alta especialización, es una entidad de
                            reconocido prestigio a nivel nacional que rápidamente se ha ganado un espacio en el campo
                            académico al dictar una serie de cursos a nivel nacional e internacional.
                        </p>
                        <p class="fs-6 mb-4" style="color: #5D7695; line-height: 1.6;">
                            Contamos con una plana docente de primer nivel y de amplia experiencia en el ejercicio del
                            Derecho y la docencia universitaria, garantizando una formación jurídica de vanguardia.
                        </p>
                        <div class="d-flex align-items-center p-3 rounded-3"
                            style="background-color: #FFFFFF; border-left: 4px solid #F49685;">
                            <i class="bi-shield-check fs-2 me-3" style="color: #F49685;"></i>
                            <div>
                                <span class="d-block fw-bold" style="color: #01254D;">Educación Jurídica de
                                    Excelencia</span>
                                <small style="color: #5D7695;">Más de 25 años formando líderes en el Derecho</small>
                            </div>
                        </div>
                    </div>
                    <!-- End Col -->

                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm p-4 p-md-5 rounded-3" style="background-color: #FFFFFF;">
                            <div class="d-flex align-items-center mb-4 pb-2 border-bottom"
                                style="border-color: #F0EADC !important;">
                                <span class="btn btn-icon rounded-circle me-3"
                                    style="background-color: #F0EADC; color: #01254D; width: 3rem; height: 3rem; pointer-events: none;">
                                    <i class="bi-mortarboard-fill fs-3" style="color: #01254D;"></i>
                                </span>
                                <h4 class="mb-0" style="color: #01254D; font-weight: 700;">Programas y cursos que dicta
                                    APECC:</h4>
                            </div>
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <div class="d-flex align-items-start">
                                        <i class="bi-check-circle-fill fs-5 me-2 mt-1" style="color: #F49685;"></i>
                                        <span style="color: #01254D; font-weight: 500;">Diplomados de
                                            Especialización</span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="d-flex align-items-start">
                                        <i class="bi-check-circle-fill fs-5 me-2 mt-1" style="color: #F49685;"></i>
                                        <span style="color: #01254D; font-weight: 500;">Cursos de alta
                                            especialización</span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="d-flex align-items-start">
                                        <i class="bi-check-circle-fill fs-5 me-2 mt-1" style="color: #F49685;"></i>
                                        <span style="color: #01254D; font-weight: 500;">Litigación Oral
                                            Internacional</span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="d-flex align-items-start">
                                        <i class="bi-check-circle-fill fs-5 me-2 mt-1" style="color: #F49685;"></i>
                                        <span style="color: #01254D; font-weight: 500;">Aspirantes a jueces y
                                            fiscales</span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="d-flex align-items-start">
                                        <i class="bi-check-circle-fill fs-5 me-2 mt-1" style="color: #F49685;"></i>
                                        <span style="color: #01254D; font-weight: 500;">Vocales y Fiscales
                                            Supremos</span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="d-flex align-items-start">
                                        <i class="bi-check-circle-fill fs-5 me-2 mt-1" style="color: #F49685;"></i>
                                        <span style="color: #01254D; font-weight: 500;">Conciliación Básica y
                                            Familia</span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="d-flex align-items-start">
                                        <i class="bi-check-circle-fill fs-5 me-2 mt-1" style="color: #F49685;"></i>
                                        <span style="color: #01254D; font-weight: 500;">Actualización Jurídica</span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="d-flex align-items-start">
                                        <i class="bi-check-circle-fill fs-5 me-2 mt-1" style="color: #F49685;"></i>
                                        <span style="color: #01254D; font-weight: 500;">Formación de Árbitros</span>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="d-flex align-items-start pt-3 border-top"
                                        style="border-color: #F0EADC !important;">
                                        <i class="bi-check-circle-fill fs-5 me-2 mt-1" style="color: #F49685;"></i>
                                        <span style="color: #01254D; font-weight: 600;">Congresos, seminarios nacionales
                                            e internacionales y pasantías</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- End Col -->
                </div>
                <!-- End Row -->
            </div>
        </div>
        <!-- ================= END SOBRE APECC ================= -->

