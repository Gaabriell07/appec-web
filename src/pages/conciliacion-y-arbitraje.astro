---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Conciliación Extrajudicial y Arbitraje | APECC - Asociación Peruana de Ciencias Jurídicas y Conciliación" description="Asociación Peruana de Ciencias Jurídicas y Conciliación" activePage="conciliacion-y-arbitraje">
<!-- Hero Banner -->
        <div class="py-7 py-lg-10" style="background-color: #01254D;">
            <div class="container text-center text-white">
                <span class="badge px-3 py-2 rounded-pill mb-3" style="background-color: #F49685; color: #FFFFFF; font-weight: 600;">
                    Resolución Extrajudicial de Conflictos
                </span>
                <h1 class="display-4 text-white fw-bold mb-3">Conciliación Extrajudicial y Arbitraje</h1>
                <p class="lead mx-auto" style="max-width: 44rem; color: #F0EADC;">
                    Servicios de solución rápida, pacífica y económica de controversias con autorización oficial del Ministerio de Justicia y Derechos Humanos (MINJUS).
                </p>
                <!-- Breadcrumbs -->
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-light justify-content-center mb-0">
                        <li class="breadcrumb-item"><a href="/" style="color: #F7B0AB;">Inicio</a></li>
                        <li class="breadcrumb-item"><a href="/nosotros" style="color: #F7B0AB;">Nosotros</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Conciliación y Arbitraje</li>
                    </ol>
                </nav>
            </div>
        </div>
        <!-- End Hero Banner -->

        <!-- Dos Centros Principales -->
        <div class="py-7 py-lg-10" style="background-color: #F0EADC;">
            <div class="container">
                <div class="row g-5 align-items-stretch">
                    <!-- Centro de Formación y Capacitación -->
                    <div class="col-lg-6">
                        <div class="card h-100 border-0 shadow-sm p-4 p-md-6 rounded-3" style="background-color: #FFFFFF; border-top: 5px solid #F49685 !important;">
                            <div class="mb-4">
                                <span class="badge px-3 py-2 rounded-pill me-2 mb-2" style="background-color: #01254D; color: #FFFFFF;">
                                    <i class="bi-shield-check me-1"></i> R.M. Nº 122-2000-JUS
                                </span>
                                <span class="badge px-3 py-2 rounded-pill mb-2" style="background-color: #F49685; color: #FFFFFF;">
                                    <i class="bi-award me-1"></i> R.D. Nº 915-2008-JUS
                                </span>
                            </div>

                            <h2 class="h3 mb-3" style="color: #01254D; font-weight: 700;">
                                Centro de Formación y Capacitación de Conciliadores
                            </h2>

                            <p class="fs-5 mb-4" style="color: #01254D; line-height: 1.7;">
                                APECC está autorizado a funcionar como <strong>CENTRO DE FORMACION Y CAPACITACION DE CONCILIADORES</strong>, según Resolución Ministerial Nº 122-2000-JUS y Resolución Directoral Nº 915-2008-JUS.
                            </p>

                            <p class="fs-6 mb-4" style="color: #5D7695; line-height: 1.7;">
                                La Asociación Peruana de Ciencias Jurídicas y Conciliación (APECC), de acuerdo con su Estatuto tiene como objeto principal la de realizar acciones de Formación y Capacitación de Conciliadores Extrajudiciales al amparo de la <strong>Ley Nº 26872 (Ley de Conciliación)</strong> y su Reglamento el <strong>D.S. 001-98-JUS</strong>.
                            </p>

                            <div class="mt-auto p-3 rounded-3" style="background-color: #F0EADC; border-left: 4px solid #01254D;">
                                <div class="d-flex align-items-center">
                                    <i class="bi-mortarboard fs-2 me-3" style="color: #01254D;"></i>
                                    <div>
                                        <strong class="d-block" style="color: #01254D;">Cursos Oficiales Acreditados</strong>
                                        <small style="color: #5D7695;">Conciliación Extrajudicial Básica y Especializada en Familia</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- End Centro de Formación -->

                    <!-- Centro de Conciliación y Arbitraje -->
                    <div class="col-lg-6">
                        <div class="card h-100 border-0 shadow-sm p-4 p-md-6 rounded-3" style="background-color: #FFFFFF; border-top: 5px solid #01254D !important;">
                            <div class="mb-4">
                                <span class="badge px-3 py-2 rounded-pill mb-2" style="background-color: #01254D; color: #FFFFFF;">
                                    <i class="bi-check-circle-fill me-1"></i> R.V.M. Nº 141-2001-JUS
                                </span>
                            </div>

                            <h2 class="h3 mb-3" style="color: #01254D; font-weight: 700;">
                                Centro de Conciliación y Arbitraje
                            </h2>

                            <p class="fs-5 mb-4" style="color: #01254D; line-height: 1.7;">
                                Autorizado por <strong>Resolución Viceministerial Nº 141-2001-JUS</strong>. APECC pone a su disposición su Centro de Conciliación y Arbitraje, ofreciéndole la posibilidad de resolver sus conflictos de manera rápida a bajo costo, propiciando el diálogo y el acuerdo entre las partes.
                            </p>

                            <p class="fs-6 mb-4" style="color: #5D7695; line-height: 1.7;">
                                Contamos con profesionales de reconocido prestigio y solvencia moral, ofrecemos tarifas económicas. <strong>¡Los esperamos!</strong>
                            </p>

                            <div class="mt-auto p-3 rounded-3" style="background-color: #F0EADC; border-left: 4px solid #F49685;">
                                <div class="d-flex align-items-center">
                                    <i class="bi-shield-check fs-2 me-3" style="color: #F49685;"></i>
                                    <div>
                                        <strong class="d-block" style="color: #01254D;">Seguridad Jurídica y Eficacia</strong>
                                        <small style="color: #5D7695;">Actas de Conciliación con valor de Título de Ejecución</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- End Centro de Conciliación -->
                </div>
            </div>
        </div>
        <!-- End Dos Centros Principales -->

        <!-- Ventajas de la Conciliación -->
        <div class="py-7 py-lg-10" style="background-color: #FFFFFF;">
            <div class="container">
                <div class="text-center mb-7">
                    <span class="badge px-3 py-2 rounded-pill mb-2" style="background-color: #F7B0AB; color: #01254D; font-weight: 600;">
                        Ventajas de Conciliar con APECC
                    </span>
                    <h2 class="display-6" style="color: #01254D; font-weight: 700;">¿Por qué elegir nuestro Centro?</h2>
                    <p class="lead" style="color: #5D7695;">Soluciones pacíficas, válidas legalmente y al alcance de todos.</p>
                </div>

                <div class="row g-4">
                    <div class="col-md-3 col-sm-6">
                        <div class="p-4 rounded-3 h-100 text-center" style="background-color: #F0EADC; border: 1px solid rgba(1,37,77,0.08);">
                            <div class="mb-3">
                                <span class="btn btn-icon rounded-circle" style="background-color: #01254D; width: 3.5rem; height: 3.5rem; pointer-events: none;">
                                    <i class="bi-clock-history fs-2 text-white"></i>
                                </span>
                            </div>
                            <h4 class="h5" style="color: #01254D;">Rapidez</h4>
                            <p class="small mb-0" style="color: #5D7695;">Resuelve conflictos en una o pocas sesiones sin los prolongados plazos judiciales.</p>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <div class="p-4 rounded-3 h-100 text-center" style="background-color: #F0EADC; border: 1px solid rgba(1,37,77,0.08);">
                            <div class="mb-3">
                                <span class="btn btn-icon rounded-circle" style="background-color: #F49685; width: 3.5rem; height: 3.5rem; pointer-events: none;">
                                    <i class="bi-wallet2 fs-2 text-white"></i>
                                </span>
                            </div>
                            <h4 class="h5" style="color: #01254D;">Tarifas Económicas</h4>
                            <p class="small mb-0" style="color: #5D7695;">Ahorro sustancial frente a los altos costos y tasas de un litigio judicial.</p>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <div class="p-4 rounded-3 h-100 text-center" style="background-color: #F0EADC; border: 1px solid rgba(1,37,77,0.08);">
                            <div class="mb-3">
                                <span class="btn btn-icon rounded-circle" style="background-color: #5D7695; width: 3.5rem; height: 3.5rem; pointer-events: none;">
                                    <i class="bi-file-earmark-lock2 fs-2 text-white"></i>
                                </span>
                            </div>
                            <h4 class="h5" style="color: #01254D;">Confidencialidad</h4>
                            <p class="small mb-0" style="color: #5D7695;">Absoluta reserva sobre los acuerdos y las materias tratadas entre las partes.</p>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <div class="p-4 rounded-3 h-100 text-center" style="background-color: #F0EADC; border: 1px solid rgba(1,37,77,0.08);">
                            <div class="mb-3">
                                <span class="btn btn-icon rounded-circle" style="background-color: #01254D; width: 3.5rem; height: 3.5rem; pointer-events: none;">
                                    <i class="bi-award fs-2 text-white"></i>
                                </span>
                            </div>
                            <h4 class="h5" style="color: #01254D;">Valor de Sentencia</h4>
                            <p class="small mb-0" style="color: #5D7695;">El Acta de Conciliación con Acuerdo tiene mérito ejecutivo equivalente a una sentencia judicial.</p>
                        </div>
                    </div>
                </div>

                <!-- Contact Box -->
                <div class="mt-8 text-center p-5 rounded-3" style="background-color: #01254D;">
                    <h3 class="text-white mb-3">¿Necesita conciliar o arbitrar una controversia?</h3>
                    <p class="lead mb-4" style="color: #F0EADC;">Nuestros conciliadores y árbitros acreditados están a su servicio.</p>
                    <a class="btn btn-lg px-5 py-3 fw-bold rounded-pill" href="/nosotros#contactsSection" style="background-color: #F49685; color: #FFFFFF;">
                        Contactar con el Centro
                    </a>
                </div>
            </div>
        </div>
        <!-- End Ventajas de la Conciliación -->

</Layout>
