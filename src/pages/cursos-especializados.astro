---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cursos especializados | APECC - Asociación Peruana de Ciencias Jurídicas y Conciliación" description="Asociación Peruana de Ciencias Jurídicas y Conciliación" activePage="cursos">
<!-- Banner -->
        <div id="banner-container" class="container content-space-t-1">
            <div class="bg-primary rounded-2 overflow-hidden gradient-x-overlay-sm-dark"
                 style="background: url(https://colegioabogados.org.pe/static/img/banner/2.38406452acb1.jpg) right bottom no-repeat; background-size: cover;">
                <div class="w-lg-50 py-8 px-6">
                    <h1 class="display-4 text-white">Cursos especializados</h1>
                    <p class="lead text-white mb-0">
                        Accede a más de
                        <span class="fw-semi-bold">568</span>
                        cursos de corta duración y no pares de aprender.
                    </p>
                </div>
            </div>
        </div>
        <!-- End Banner -->
    

    <!-- Card List -->
    <div class="container content-space-1 content-space-md-2 content-space-b-lg-3">
        <div class="row">
            <div class="col-lg-3 mb-5 mb-lg-0">
                <!-- Navbar -->
                <div class="navbar-expand-lg">
                    <!-- Navbar Toggle -->
                    <div class="d-grid">
                        <button id="mobile-navbar-button" type="button" class="navbar-toggler btn btn-white mb-3"
                                data-bs-toggle="collapse" data-bs-target="#navbarVerticalNavMenuEg3"
                                aria-label="Toggle navigation" aria-expanded="false"
                                aria-controls="navbarVerticalNavMenuEg3">
                            <span class="d-flex justify-content-between align-items-center">
                                <span class="text-dark">Filtros de categoría</span>

                                <span class="navbar-toggler-default">
                                    <i class="bi-list"></i>
                                </span>

                                <span class="navbar-toggler-toggled">
                                    <i class="bi-x"></i>
                                </span>
                            </span>
                        </button>
                    </div>
                    <!-- End Navbar Toggle -->

                    <div class="border border-lg-1 rounded py-lg-5 px-3">
                        <h5 class="mb-5 h4 text-center d-none d-lg-block">Filtros de categoría</h5>

                        <!-- Navbar Collapse -->
                        <div id="navbarVerticalNavMenuEg3"
                             class="collapse navbar-collapse w-100">
                            <div id="shopNavCategories" class="nav nav-pills nav-vertical nav-no-vertical-line w-100">
                                <!-- Todas -->
                                <a class="nav-link text-wrap fw-bold px-0 active text-primary apecc-cat-filter" href="javascript:;" data-filter="all">
                                    <i class="bi-grid nav-icon text-primary me-2"></i>
                                    Todas las especialidades
                                </a>

                                <!-- Conciliación Extrajudicial -->
                                <a class="nav-link dropdown-toggle text-wrap fw-bold px-0 collapsed apecc-cat-filter"
                                   href="#" role="button"
                                   data-bs-toggle="collapse"
                                   data-bs-target="#shopCatConciliacion"
                                   aria-expanded="true"
                                   aria-controls="shopCatConciliacion"
                                   data-filter="cat-conciliacion">
                                    <i class="bi-dash nav-icon text-primary"></i>
                                    Conciliación Extrajudicial
                                </a>
                                <div id="shopCatConciliacion" class="nav-collapse collapse show px-0" data-bs-parent="#shopNavCategories">
                                    <div class="ms-3 my-1">
                                        <a class="nav-link text-wrap py-1 text-muted apecc-cat-filter" href="javascript:;" data-filter="cat-conciliacion-familiar">
                                            <i class="bi-dot"></i> Conciliación Familiar
                                        </a>
                                        <a class="nav-link text-wrap py-1 text-muted apecc-cat-filter" href="javascript:;" data-filter="cat-conciliacion-formacion">
                                            <i class="bi-dot"></i> Formación de Conciliadores
                                        </a>
                                    </div>
                                </div>

                                <!-- Derecho Penal -->
                                <a class="nav-link dropdown-toggle text-wrap fw-bold px-0 collapsed apecc-cat-filter"
                                   href="#" role="button"
                                   data-bs-toggle="collapse"
                                   data-bs-target="#shopCatPenal"
                                   aria-expanded="true"
                                   aria-controls="shopCatPenal"
                                   data-filter="cat-penal">
                                    <i class="bi-dash nav-icon text-primary"></i>
                                    Derecho Penal y Procesal Penal
                                </a>
                                <div id="shopCatPenal" class="nav-collapse collapse show px-0" data-bs-parent="#shopNavCategories">
                                    <div class="ms-3 my-1">
                                        <a class="nav-link text-wrap py-1 text-muted apecc-cat-filter" href="javascript:;" data-filter="cat-penal-corrupcion">
                                            <i class="bi-dot"></i> Corrupción y Crimen Organizado
                                        </a>
                                        <a class="nav-link text-wrap py-1 text-muted apecc-cat-filter" href="javascript:;" data-filter="cat-penal-delitos">
                                            <i class="bi-dot"></i> Delitos Graves y Minería Ilegal
                                        </a>
                                    </div>
                                </div>

                                <!-- Arbitraje -->
                                <a class="nav-link dropdown-toggle text-wrap fw-bold px-0 collapsed apecc-cat-filter"
                                   href="#" role="button"
                                   data-bs-toggle="collapse"
                                   data-bs-target="#shopCatArbitraje"
                                   aria-expanded="true"
                                   aria-controls="shopCatArbitraje"
                                   data-filter="cat-arbitraje">
                                    <i class="bi-dash nav-icon text-primary"></i>
                                    Arbitraje y Solución de Conflictos
                                </a>
                                <div id="shopCatArbitraje" class="nav-collapse collapse show px-0" data-bs-parent="#shopNavCategories">
                                    <div class="ms-3 my-1">
                                        <a class="nav-link text-wrap py-1 text-muted apecc-cat-filter" href="javascript:;" data-filter="cat-arbitraje">
                                            <i class="bi-dot"></i> Arbitraje Especializado
                                        </a>
                                    </div>
                                </div>

                                <!-- Pasantías Internacionales -->
                                <a class="nav-link dropdown-toggle text-wrap fw-bold px-0 collapsed apecc-cat-filter"
                                   href="#" role="button"
                                   data-bs-toggle="collapse"
                                   data-bs-target="#shopCatPasantias"
                                   aria-expanded="true"
                                   aria-controls="shopCatPasantias"
                                   data-filter="cat-pasantias">
                                    <i class="bi-dash nav-icon text-primary"></i>
                                    Pasantías Internacionales
                                </a>
                                <div id="shopCatPasantias" class="nav-collapse collapse show px-0" data-bs-parent="#shopNavCategories">
                                    <div class="ms-3 my-1">
                                        <a class="nav-link text-wrap py-1 text-muted apecc-cat-filter" href="javascript:;" data-filter="cat-pasantia-argentina">
                                            <i class="bi-dot"></i> Argentina
                                        </a>
                                        <a class="nav-link text-wrap py-1 text-muted apecc-cat-filter" href="javascript:;" data-filter="cat-pasantia-brasil">
                                            <i class="bi-dot"></i> Brasil
                                        </a>
                                        <a class="nav-link text-wrap py-1 text-muted apecc-cat-filter" href="javascript:;" data-filter="cat-pasantia-miami">
                                            <i class="bi-dot"></i> EE.UU. (Miami)
                                        </a>
                                        <a class="nav-link text-wrap py-1 text-muted apecc-cat-filter" href="javascript:;" data-filter="cat-pasantia-medellin">
                                            <i class="bi-dot"></i> Colombia (Medellín)
                                        </a>
                                    </div>
                                </div></div>
                        </div>
                        <!-- End Navbar Collapse -->
                    </div>
                </div>
                <!-- End Navbar -->
            </div>
            <!-- End Col -->

            <div class="col-lg-9">
                <!-- Filter -->
                <div class="border-bottom pb-3 mb-5">
                    <div class="row justify-content-between align-items-center">
                        <h3 class="mb-0 col-md-6 order-2 order-md-1 mt-3 mt-md-0">
                            <span class="text-dark fw-semi-bold">
                                <span id="apeccCourseCount">9 programas</span>
                            </span>
                            encontrados
                            
                        </h3>

                        <form action="/buscar/" class="col-md-6 order-1 order-md-2">
                            <!-- Input Card -->
                            <div class="input-card border">
                                <div class="input-card-form">
                                    <label for="searchForm" class="form-label visually-hidden">
                                        Encuentra algo que aprender
                                    </label>
                                    <div class="input-group input-group-merge">
                                        <span class="input-group-prepend input-group-text">
                                            <i class="bi-search"></i>
                                        </span>
                                        <input type="text"
                                               class="form-control"
                                               id="searchForm"
                                               name="q"
                                               placeholder="Encuentra algo que aprender"
                                               aria-label="Encuentra algo que aprender">
                                    </div>
                                </div>
                                <button class="btn btn-primary">
                                    <i class="bi-arrow-right"></i>
                                </button>
                            </div>
                            <!-- End Input Card -->
                        </form>
                    </div>

                    
                </div>
                <!-- End Filter -->

                <div class="mb-10">
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3">
                        
                        <!-- Card 1: Corrupción de Funcionarios -->
                        <div class="col mb-5 apecc-course-card cat-penal cat-penal-corrupcion">
                            <div class="card card-flush shadow-none h-100">
