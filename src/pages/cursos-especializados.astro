                        <div class="col mb-5 apecc-course-card cat-conciliacion cat-conciliacion-formacion">
                            <div class="card card-flush shadow-none h-100">
                                <a class="card-pinned" href="https://apecc.com.pe/noticias/producto/curso-de-formacion-y-capacitacion-de-conciliadores-extrajudiciales/">
                                    <img class="card-img-top" src="/Cursos/conciliacion_2.jpg" alt="Curso de Formación y Capacitación de Conciliadores Extrajudiciales">
                                    <div class="card-pinned-top-start">
                                        <small class="badge bg-success rounded-pill">Oficial MINJUS</small>
                                    </div>
