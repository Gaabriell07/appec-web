---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Librería Jurídica | APECC - Asociación Peruana de Ciencias Jurídicas y Conciliación" description="Asociación Peruana de Ciencias Jurídicas y Conciliación" activePage="libreria">
<!-- Hero Banner -->
        <div class="py-7 py-lg-10" style="background-color: #01254D;">
            <div class="container text-center text-white">
                <span class="badge px-3 py-2 rounded-pill mb-3" style="background-color: #F49685; color: #FFFFFF; font-weight: 600;">
                    Editorial Jurídica APECC
