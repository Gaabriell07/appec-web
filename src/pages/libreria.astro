                <p class="lead mx-auto mb-4" style="max-width: 44rem; color: #F0EADC;">
                    Obras doctrinarias, manuales prácticos y tratados de litigación oral del Dr. Oscar Peña Gonzáles y destacados juristas del país.
                </p>
                <!-- Breadcrumbs -->
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-light justify-content-center mb-0">
                        <li class="breadcrumb-item"><a href="/" style="color: #F7B0AB;">Inicio</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Librería</li>
                    </ol>
                </nav>
            </div>
        </div>
        <!-- End Hero Banner -->

        <!-- Features Bar -->
