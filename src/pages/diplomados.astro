<script is:inline>
document.addEventListener('DOMContentLoaded', function () {
        const filterButtons = document.querySelectorAll('.apecc-cat-filter');
        const cards = document.querySelectorAll('.apecc-course-card');
        const countEl = document.getElementById('apeccDiplomatCount');
        const searchInput = document.getElementById('searchForm');

        function applyFilter(cat) {
            let visibleCount = 0;
            cards.forEach(card => {
                if (cat === 'all' || card.classList.contains(cat)) {
                    card.style.display = '';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });
            if (countEl) countEl.innerText = visibleCount + ' programas';
        }

        filterButtons.forEach(btn => {
            btn.addEventListener('click', function (e) {
                const filter = this.getAttribute('data-filter');
                if (filter) {
                    filterButtons.forEach(b => {
                        b.classList.remove('active', 'text-primary', 'fw-bold');
                        b.classList.add('text-muted');
                    });
                    this.classList.add('active', 'text-primary', 'fw-bold');
                    this.classList.remove('text-muted');
                    applyFilter(filter);
                }
            });
        });

        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const q = this.value.toLowerCase().trim();
                let visibleCount = 0;
                cards.forEach(card => {
                    const text = card.innerText.toLowerCase();
                    if (!q || text.includes(q)) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });
                if (countEl) countEl.innerText = visibleCount + ' programas';
            });
        }
    });
</script>
