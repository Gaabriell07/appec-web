---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Nuestros diplomados | APECC - Asociación Peruana de Ciencias Jurídicas y Conciliación" description="Asociación Peruana de Ciencias Jurídicas y Conciliación" activePage="diplomados">
<!-- Banner -->
        <div class="container content-space-t-1">
            <div class="rounded-2 position-relative overflow-hidden gradient-x-overlay-sm-dark"
                 style="background: url(https://colegioabogados.org.pe/static/img/banner/2.38406452acb1.jpg) right bottom no-repeat; background-size: cover;">
                <div class="w-lg-50 py-8 px-6">
                    <h1 class="display-4 text-white">Nuestros diplomados</h1>
                    <p class="lead text-white mb-0">
                        Extiende tu carrera con nuestros diplomados.
                    </p>
                </div>
            </div>
        </div>
        <!-- End Banner -->
    

    <!-- Card List -->
    <div class="container content-space-1 content-space-md-2 content-space-b-lg-3">
        <div class="row">
            <div class="col-lg-3 mb-5 mb-lg-0">
