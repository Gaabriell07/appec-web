                                            <i class="bi-dot"></i> Delitos Graves y Minería Ilegal
                                        </a>
                                    </div>
                                </div></div>
                        </div>
                        <!-- End Navbar Collapse -->
                    </div>
                </div>
                <!-- End Navbar -->
            </div>
            <!-- End Col -->

            <div class="col-lg-9">
                <!-- Filter -->
                <div class="border-bottom pb-3 mb-5">
                    <div class="row justify-content-between align-items-center">
                        <h3 class="mb-0 col-md-6 order-2 order-md-1 mt-3 mt-md-0">
                            <span class="text-dark fw-semi-bold">
                                <span id="apeccDiplomatCount">9 programas y diplomados</span>
                            </span>
                            encontrados
                            
                        </h3>

                        <form action="/buscar/" class="col-md-6 order-1 order-md-2">
                            <!-- Input Card -->
                            <div class="input-card border">
                                <div class="input-card-form">
                                    <label for="searchForm" class="form-label visually-hidden">
                                        Encuentra algo que aprender
                                    </label>
                                    <div class="input-group input-group-merge">
                                        <span class="input-group-prepend input-group-text">
                                            <i class="bi-search"></i>
                                        </span>
                                        <input type="text"
                                               class="form-control"
                                               id="searchForm"
                                               name="q"
                                               placeholder="Encuentra algo que aprender"
                                               aria-label="Encuentra algo que aprender">
                                    </div>
                                </div>
                                <button class="btn btn-primary">
                                    <i class="bi-arrow-right"></i>
                                </button>
                            </div>
                            <!-- End Input Card -->
                        </form>
                    </div>

                    
                </div>
                <!-- End Filter -->

                <div class="d-grid gap-5 mb-10">
                    
